# Aplicación
APP_ENV=development
# Compose fija PORT=8000 internamente; el Dockerfile fuera de Compose usa PORT.
PORT=8000
# Puertos del host, distintos a los de RescueSync (8000 y 5432).
API_PORT=8001
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. DATABASE_URL tiene prioridad cuando se encuentra definida.
DATABASE_URL=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5433
POSTGRES_DB=rescuesync_nacional
POSTGRES_USER=rescuesync_nacional
POSTGRES_PASSWORD=rescuesync_nacional_dev

# JWT nacional: configurar una clave aleatoria de al menos 32 caracteres.
# Vacío usa una clave efímera en desarrollo/test; obligatorio en producción.
JWT_SECRET=
JWT_ISSUER=rescuesync-nacional
JWT_AUDIENCE=rescuesync
JWT_ACCESS_SECONDS=1800

# Límites transaccionales de compromiso/liberación/cierre; reintentar la misma clave.
OPERACION_LOCK_TIMEOUT_MS=5000
OPERACION_STATEMENT_TIMEOUT_MS=15000
