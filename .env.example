# Aplicación
APP_ENV=development
# Compose fija PORT=8000 internamente; el Dockerfile fuera de Compose usa PORT.
PORT=8000
# Puertos del host, distintos a los de RescueSync (8000 y 5432).
API_PORT=8001
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. DATABASE_URL tiene prioridad cuando se encuentra definida.
DATABASE_URL=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5433
POSTGRES_DB=rescuesync_nacional
POSTGRES_USER=rescuesync_nacional
POSTGRES_PASSWORD=rescuesync_nacional_dev
