# Aplicación
APP_ENV=development
# Compose fija PORT=8000 internamente; el Dockerfile fuera de Compose usa PORT.
PORT=8000
# Puertos del host, distintos a los de RescueSync (8000 y 5432).
API_PORT=8001
# Lista JSON de orígenes HTTP/HTTPS de las apps web que acceden desde un navegador.
# Ejemplo: ["http://localhost:5173","https://app.example.org","https://admin.example.org"]
# Sin rutas /api/v1, credenciales ni comodines. Ver docs/cors.md.
# Para uso exclusivo servidor a servidor se puede configurar [].
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. DATABASE_URL tiene prioridad cuando se encuentra definida.
DATABASE_URL=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5433
POSTGRES_DB=rescuesync_nacional
POSTGRES_USER=rescuesync_nacional
POSTGRES_PASSWORD=rescuesync_nacional_dev

# JWT nacional: configurar una clave aleatoria de al menos 32 caracteres.
# Vacío usa una clave efímera en desarrollo/test; obligatorio en producción.
JWT_SECRET=
JWT_ISSUER=rescuesync-nacional
JWT_AUDIENCE=rescuesync
JWT_ACCESS_SECONDS=1800

# Contraseña independiente para seeds y flush por HTTP (mínimo 32 caracteres).
# Vacía deshabilita los tres endpoints. Generar con secrets.token_urlsafe(48).
# Enviar en X-DB-Maintenance-Password; ver docs/mantenimiento-db.md.
DB_MAINTENANCE_PASSWORD=

# Límites transaccionales de compromiso/liberación/cierre; reintentar la misma clave.
OPERACION_LOCK_TIMEOUT_MS=5000
OPERACION_STATEMENT_TIMEOUT_MS=15000

# Aprovisionamiento idempotente del emisor en cada arranque de la imagen de producción.
# En Render: INTEGRACION_AUTO_BOOTSTRAP=true y una contraseña secreta de >=12
# caracteres; nunca usar una contraseña pública para el entorno remoto.
INTEGRACION_AUTO_BOOTSTRAP=false
INTEGRACION_LOGIN=integracion-rescuesync
INTEGRACION_SISTEMA_ORIGEN=rescuesync-local
INTEGRACION_PASSWORD=
